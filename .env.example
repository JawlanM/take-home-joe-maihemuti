# Copy to .env (Docker Compose) or backend/.env (running the backend directly).
# Optional: without a key the app runs and AI summaries show as "disabled".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Only needed when running the backend outside Docker:
MONGODB_URI=mongodb://localhost:27017
CORS_ORIGINS=http://localhost:5173
